# HookForge Backend Environment Configuration

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database Settings
# Note: For local development on host, connect to PostgreSQL Docker container via host port 5434.
# When running inside Docker container, DATABASE_HOST is "postgres" and DATABASE_PORT is 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=webhooks
DATABASE_PASSWORD=webhooks
DATABASE_NAME=webhooks
DATABASE_POOL_MAX=20

# Optional full database URL override:
# DATABASE_URL=postgresql://webhooks:webhooks@localhost:5434/webhooks

# CORS Configuration (comma-separated origins; in production, '*' is disallowed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retry Policy
RETRY_MAX_ATTEMPTS=8
RETRY_BASE_DELAY=5s
RETRY_MAX_DELAY=1h

# Dispatcher
DISPATCHER_POLL_INTERVAL=0.5s
DISPATCHER_BATCH_SIZE=50
DISPATCHER_WORKER_CONCURRENCY=50
DISPATCHER_LEASE_MARGIN=30s
DISPATCHER_REAPER_INTERVAL=15s

# Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_DURATION=1m

# HTTP Outbound Webhook Timeouts & Response Limits
HTTP_CONNECT_TIMEOUT=3s
HTTP_READ_TIMEOUT=10s
# Maximum response body size from webhook receiver (bytes, default 1MB = 1048576 bytes)
HTTP_RESPONSE_MAX_BYTES=1048576

# Ingest Payload Limit (bytes, default 256KB)
INGEST_MAX_PAYLOAD_BYTES=262144

# Inbound Rate Limiting
# IP-based failed authentication protection (default: 10 failed attempts per 60000ms/1m)
RATE_LIMIT_AUTH_FAIL_LIMIT=10
RATE_LIMIT_AUTH_FAIL_WINDOW_MS=60000

# Per-tenant API rate limit (default: 100 requests per 1000ms/1s)
RATE_LIMIT_TENANT_LIMIT=100
RATE_LIMIT_TENANT_WINDOW_MS=1000

# Health endpoint IP rate limit (default: 30 requests per 60000ms/1m)
RATE_LIMIT_HEALTH_LIMIT=30
RATE_LIMIT_HEALTH_WINDOW_MS=60000

# Tenant API-Key Authentication Cache
AUTH_CACHE_ENABLED=true
AUTH_CACHE_TTL_MS=60000
AUTH_CACHE_MAX_ENTRIES=10000

# Trust Proxy (default: false).
# SECURITY WARNING: Setting to true is safe ONLY when HookForge runs behind a trusted reverse proxy
# (e.g. AWS ALB, Cloudflare, NGINX) that sanitizes and overwrites all forwarded headers.
# When false, client-supplied X-Forwarded-For headers are strictly ignored to prevent rate limit spoofing.
TRUST_PROXY=false

# Security & Secret Encryption
# AES-256-GCM encryption key for webhook signing secrets stored at rest.
# Must be exactly 32 bytes (256 bits) when base64-decoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit a real encryption key.
WEBHOOK_SECRET_ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here
