# HookForge Backend Environment Configuration

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database Settings
# Note: For local development on host, connect to PostgreSQL Docker container via host port 5434.
# When running inside Docker container, DATABASE_HOST is "postgres" and DATABASE_PORT is 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=webhooks
DATABASE_PASSWORD=webhooks
DATABASE_NAME=webhooks
DATABASE_POOL_MAX=20

# Optional full database URL override:
# DATABASE_URL=postgresql://webhooks:webhooks@localhost:5434/webhooks

# CORS Configuration (comma-separated origins; in production, '*' is disallowed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Retry Policy
RETRY_MAX_ATTEMPTS=8
RETRY_BASE_DELAY=5s
RETRY_MAX_DELAY=1h

# Dispatcher
DISPATCHER_POLL_INTERVAL=0.5s
DISPATCHER_BATCH_SIZE=50
DISPATCHER_WORKER_CONCURRENCY=50
DISPATCHER_LEASE_MARGIN=30s
DISPATCHER_REAPER_INTERVAL=15s

# Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_DURATION=1m

# HTTP Timeouts
HTTP_CONNECT_TIMEOUT=3s
HTTP_READ_TIMEOUT=10s

# Ingest Payload Limit (bytes, default 256KB)
INGEST_MAX_PAYLOAD_BYTES=262144
